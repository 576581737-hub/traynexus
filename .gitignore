# ====================================================================
# Traynexus .gitignore
# ====================================================================

# ---------- 构建产物 ----------
bin/
obj/
*.exe
*.dll
*.pdb
*.cache

# ---------- 第三方运行时依赖（从 NuGet 还原，不入库）----------
# WebView2 运行时托管 DLL：开发机从 NuGet 还原到 lib/，不入库
lib/
# 但保留目录占位
!lib/.gitkeep

# ---------- WebView2 运行时缓存（exe 运行时生成）----------
*.WebView2/
**/EBWebView/

# ---------- IDE / 编辑器 ----------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.swp
*~

# ---------- 临时与备份文件 ----------
*.tmp
*.bak
*.log
error.log

# ---------- 系统 ----------
Thumbs.db
Desktop.ini
.DS_Store

# ---------- Agent 辅助目录（会话临时产物，不入库）----------
.workbuddy/

# ---------- 内部 / 归档（不对外开源）----------
.zcode/           # 编辑器/规划会话临时数据
_attic/           # 历史归档：不参与编译的旧原型与文档
deliverables/     # 内部规划文档（PRD / 架构），非产品运行时所需
build_log.txt     # 本地构建日志（.txt 不在上面的 *.log 规则内）
